# Copie este archivo como .env y complete los valores
PORT=3000

# --- Supabase (Project Settings > API) ---
DB_PROVIDER=supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque_aqui_la_service_role_key

# --- Seguridad ---
JWT_SECRET=cambie_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES=8h

# --- Chatbot con IA (OpenAI) ---
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-coloque_aqui_su_clave
# Alternativa: AI_PROVIDER=gemini y GEMINI_API_KEY=...

# Porcentaje extra de pintura por desperdicio (0.10 = 10 %)
FACTOR_DESPERDICIO=0.10
