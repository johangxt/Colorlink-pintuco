{
  "name": "pintuco-app",
  "version": "1.0.0",
  "description": "Aplicación web de venta de pinturas y gestión de servicios de pintura con chatbot de IA",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "demo": "DB_PROVIDER=memory node src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "stats": "node scripts/estadisticas.js",
    "eval:chatbot": "node scripts/evaluar-chatbot.js",
    "seed:sql": "node scripts/generar-seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
